<?xml version="1.0" encoding="utf-8"?>
<modDesc xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         descVersion="110"
         xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/modDesc.xsd">

    <author>The-0kami / Agriculture Science</author>
    <version>0.1.0.0</version>

    <title>
        <en>Dev Tools</en>
        <de>Dev Tools</de>
    </title>

    <description>
        <en><![CDATA[
Development and reverse-engineering helpers for Farming Simulator 25.

Current tool: Object Inspector
- Inspect the rigid body under the camera crosshair
- Write node and collision data to log.txt
- Repeat the last successful dump
        ]]></en>
        <de><![CDATA[
Entwicklungs- und Analysewerkzeuge für Farming Simulator 25.

Aktuelles Werkzeug: Object Inspector
- Objekt unter dem Kamera-Fadenkreuz untersuchen
- Node- und Kollisionsdaten in log.txt schreiben
- Letzten erfolgreichen Dump erneut ausgeben
        ]]></de>
    </description>

    <multiplayer supported="true"/>

    <l10n>
        <text name="input_DEVTOOLS_INSPECT_OBJECT">
            <en>Inspect object under crosshair</en>
            <de>Objekt unter Fadenkreuz untersuchen</de>
        </text>
        <text name="input_DEVTOOLS_REPEAT_DUMP">
            <en>Repeat last object dump</en>
            <de>Letzten Objekt-Dump wiederholen</de>
        </text>
    </l10n>

    <actions>
        <action name="DEVTOOLS_INSPECT_OBJECT" category="ONFOOT VEHICLE"/>
        <action name="DEVTOOLS_REPEAT_DUMP" category="ONFOOT VEHICLE"/>
    </actions>

    <inputBinding>
        <actionBinding action="DEVTOOLS_INSPECT_OBJECT">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_f8" index="1"/>
        </actionBinding>
        <actionBinding action="DEVTOOLS_REPEAT_DUMP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_f9" index="1"/>
        </actionBinding>
    </inputBinding>

    <extraSourceFiles>
        <sourceFile filename="scripts/DevTools.lua"/>
    </extraSourceFiles>
</modDesc>
