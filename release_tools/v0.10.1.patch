+function Ensure-SteamLaunchOptionFile {
+    if (-not $IsWindows -and $PSVersionTable.PSVersion.Major -ge 6) { return }
+    $target = Join-Path $ScriptRoot 'Steam_Startoption.txt'
+    if (Test-Path -LiteralPath $target) { return }
+
+    $bat = Join-Path $ScriptRoot 'Start_BauerVonNebenan.bat'
+    $line = ('"{0}" %command%' -f $bat)
+    $content = @(
+        'AGRICULTURE SCIENCE // STEAM STARTOPTION',
+        '',
+        'Diese Zeile in Steam unter:',
+        'Eigenschaften -> Allgemein -> Startoptionen',
+        '',
+        $line,
+        '',
+        'Hinweis: Wenn der Launcher-Ordner verschoben wird, diese Datei loeschen.',
+        'Beim naechsten Start wird sie mit dem neuen Pfad erneut erzeugt.'
