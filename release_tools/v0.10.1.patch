+    Write-ColorLine '[STEAM] Steam_Startoption.txt wurde einmalig erzeugt.' Cyan
+}
+
+function Invoke-StrictModQuarantine {
+    param(
+        [string]$ModFolder,
+        [string[]]$AllowedFileNames,
+        [string]$QuarantineRoot
+    )
+
+    if (-not (Test-Path -LiteralPath $ModFolder)) { return @() }
+
+    $allowed = @{}
+    foreach ($name in @($AllowedFileNames)) {
+        if ([string]::IsNullOrWhiteSpace([string]$name)) { continue }
+        $allowed[[string]$name.ToLowerInvariant()] = $true
+    }
+
+    $extras = @(
+        Get-ChildItem -LiteralPath $ModFolder -File -Filter '*.zip' |
+        Where-Object { -not $allowed.ContainsKey($_.Name.ToLowerInvariant()) }
+    )
+    if ($extras.Count -eq 0) { return @() }
+
+    $stamp = Get-Date -Format 'yyyyMMdd_HHmmss'
+    $destination = Join-Path $QuarantineRoot $stamp
+    New-Item -ItemType Directory -Path $destination -Force | Out-Null
+
+    $moved = New-Object System.Collections.Generic.List[string]
+    foreach ($file in $extras) {
+        $dest = Join-Path $destination $file.Name
+        Move-Item -LiteralPath $file.FullName -Destination $dest -Force
+        $moved.Add($file.Name)
+    }
+
+    Write-Host ''
+    Write-ColorLine '[STRICT] Lokale Mods ausserhalb der Masterliste wurden aus dem aktiven Modordner entfernt.' DarkYellow
+    Write-ColorLine ("[STRICT] Quarantaene: {0}" -f $destination) Gray
+    foreach ($name in $moved) { Write-ColorLine ("  [QUARANTAENE] {0}" -f $name) DarkYellow }
+    Write-Host ''
+
+    return $moved.ToArray()
+}
